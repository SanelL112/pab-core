TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
OPENROUTER_API_KEY="your_openrouter_api_key"

# Canvas via ClassLink/Firefox (no Canvas personal access token required)
CANVAS_API_URL="https://your-school.instructure.com"
CANVAS_SSO_ENTRY_URL="https://launchpad.classlink.com/forsyth"
CLASSLINK_USERNAME="your_classlink_username"
CLASSLINK_PASSWORD="your_classlink_password"
# Persistent, owner-only Firefox profile. Set false only when you have a display.
CANVAS_BROWSER_HEADLESS="true"
# CANVAS_FIREFOX_PROFILE_DIR="/home/your-user/.local/share/personal-assistant-bot/canvas-firefox-profile"
# Keep this local-only service running while Canvas data is being collected.
CANVAS_USE_BROWSER_DAEMON="true"
CANVAS_BROWSER_DAEMON_URL="http://127.0.0.1:8976"
# Reauthenticate through the normal ClassLink/ADFS screens after an expired session.
# It does not bypass MFA, CAPTCHAs, or other interactive security checks.
CANVAS_REAUTH_CHECK_SECONDS="300"
CANVAS_REAUTH_COOLDOWN_SECONDS="900"
# Used only by the system service when no VNC/X11 display is available.
CANVAS_VIRTUAL_DISPLAY=":99"
# Follow linked Canvas pages and public HTTPS references. Public pages must
# match the original course/page vocabulary before they are included or recursed.
CANVAS_PAGE_LINK_MAX_DEPTH="8"
CANVAS_PAGE_LINK_MAX_ITEMS="60"
CANVAS_PAGE_LINK_TOTAL_TEXT_LIMIT="10000"
CANVAS_EXTERNAL_LINK_MAX_DEPTH="8"
CANVAS_EXTERNAL_LINK_LIMIT="8"
CANVAS_EXTERNAL_LINK_MIN_CONTEXT_MATCHES="2"

# Assignment calendar sync (disabled until /calendar enable)
# Radicale stays bound to localhost and is exposed privately through Tailscale.
ASSIGNMENT_CALENDAR_TIMEZONE="America/New_York"
ASSIGNMENT_CALDAV_COLLECTION_URL="http://127.0.0.1:5232/sanel/assignments/"
ASSIGNMENT_CALDAV_USERNAME="sanel"
ASSIGNMENT_CALDAV_PASSWORD="choose-a-strong-password"
# Set an existing dedicated calendar ID, or configure the verified calendar
# creation action so /calendar enable creates ASSIGNMENT_GOOGLE_CALENDAR_NAME.
ASSIGNMENT_GOOGLE_CALENDAR_ID=""
ASSIGNMENT_GOOGLE_CALENDAR_NAME="Assignments"
ASSIGNMENT_GOOGLE_CALENDAR_CREATE_TOOL=""
# Verified Composio event create, update, and delete action slugs.
ASSIGNMENT_GOOGLE_CREATE_TOOL=""
ASSIGNMENT_GOOGLE_UPDATE_TOOL=""
ASSIGNMENT_GOOGLE_DELETE_TOOL=""

# Antigravity CLI specific
CONVERSATION_ID="your_antigravity_conversation_id"
SUDO_PASSWORD="your_server_sudo_password"

# GroupMe configuration (optional)
GROUPME_TOKEN="your_groupme_token"
GROUPME_GROUP_ID="102851186"

# Advanced configuration (optional)
# AGENTAPI_BIN="/home/sanel/.local/bin/agy"
