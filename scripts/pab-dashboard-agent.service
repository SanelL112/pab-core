[Unit]
Description=Personal Assistant dashboard agent
After=network-online.target tailscale-online.target
Wants=network-online.target tailscale-online.target

[Service]
Type=simple
User=sanel
WorkingDirectory=/home/sanel/personal-assistant-bot-release
Environment=PAB_RUNTIME_DIR=/home/sanel/personal-assistant-bot
Environment=PAB_WORKDIR=/home/sanel/personal-assistant-bot-release
EnvironmentFile=/etc/personal-assistant-dashboard-agent.env
ExecStart=/home/sanel/personal-assistant-bot/venv/bin/python /home/sanel/personal-assistant-bot/scripts/dashboard_agent.py
Restart=on-failure
RestartSec=5
UMask=0077
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
